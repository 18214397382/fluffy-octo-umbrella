{
  "$schema": "https://schema.railpack.com/",
  "provider": "node",
  "packages": {
    "node": "18"
  },
  "build": {
    "commands": [
      "cd frontend && npm install && npm run build",
      "cd .. && npm install"
    ]
  },
  "deploy": {
    "startCommand": "node api/index.mjs",
    "variables": {
      "NODE_ENV": "production"
    }
  }
}