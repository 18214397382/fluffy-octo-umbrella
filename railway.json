{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksConfig": {
      "phases": {
        "setup": {
          "nixPkgs": ["nodejs"]
        },
        "build": {
          "cmds": ["npm install"]
        },
        "install": {
          "cmds": []
        }
      },
      "start": {
        "cmd": "node api/index.mjs"
      }
    }
  },
  "deploy": {
    "startCommand": "node api/index.mjs",
    "healthcheckPath": "/api/health"
  }
}